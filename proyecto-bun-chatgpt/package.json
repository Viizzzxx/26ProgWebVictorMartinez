{
    "name": "proyecto-bun-chatgpt",
    "version": "1.0.0",
    "description": "Chat local usando TypeScript, Bun y elementos dinamicos",
    "type": "module",
    "scripts": {
        "check": "tsc --noEmit",
        "build": "bun build ./src/main.ts --outdir=./dist --target=browser && bun build ./src/worker.ts --outdir=./dist --target=browser",
        "dev": "bun run build && bunx http-server . -p 3000 -c-1"
    },
    "dependencies": {
        "@mlc-ai/web-llm": "0.2.46"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.268",
        "typescript": "^5.0.0"
    }
}